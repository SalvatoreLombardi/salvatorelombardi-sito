# Copia questo file in `.env.local` e incolla i valori del tuo progetto Supabase.
# Li trovi su supabase.com -> il tuo progetto -> Project Settings -> API Keys
#
# ATTENZIONE: `.env.local` non va mai su GitHub (è già escluso dal .gitignore).
# La chiave "anon" invece è pubblica per natura: finisce dentro il sito compilato
# ed è sicura SOLO se hai eseguito le policy in supabase/schema.sql.
# Non usare mai qui la chiave "service_role".

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=incolla_qui_la_chiave_anon
